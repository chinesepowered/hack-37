# Agent37 Cloud (required for live audits)
AGENT37_API_KEY=sk_live_...
AGENT37_INSTANCE_ID=            # created by: npm run setup:agent37
# Public base URL where the auditor agent browses dealer sites, e.g. https://<your-app>/dealers
DEALER_SITES_BASE=
PUBLIC_URL=
# OpenAI (structured-output repair, credit memo, payoff demands)
OPENAI_API_KEY=
OPENAI_MODEL=
# Monid (market comps for collateral valuation)
MONID_API_KEY=
# InstaCloud Postgres (audit history); falls back to memory
DATABASE_URL=
# live | replay (default: live when Agent37 + dealer sites are configured)
DEFAULT_MODE=
PORT=8080
